# Optional SMTP settings for later integration
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false

# Optional OAuth2/OIDC single sign-on. Keep disabled until the school provides integration details.
