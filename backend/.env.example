DATABASE_URL="file:./supplier_system.db"
JWT_SECRET="请用 openssl rand -hex 32 生成"
INIT_ADMIN_PASSWORD="请配置强初始密码"
BACKEND_HOST=127.0.0.1
CORS_ORIGIN=

# Optional unified authentication / CAS OAuth2 settings
SSO_BASE_URL=http://127.0.0.1:8888                                                  #学校统一认证服务器根地址，比如 https://auth.xxx.edu.cn
SSO_CLIENT_ID=mock-client                                       #学校给你的应用编号
SSO_CLIENT_SECRET=mock-secret                                   #学校给你的应用密钥
SSO_REDIRECT_URI=http://127.0.0.1:8000/api/v1/sso/callback      #学校认证成功后回调到你后端的地址
SSO_FRONTEND_CALLBACK_URL=http://127.0.0.1:8100/sso/callback    #学校认证成功后回调到你前端的地址
SSO_ADMIN_ROLE_UUIDS=role-admin                                         #哪些学校角色算本系统管理员

# Optional SMTP settings for later integration
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
